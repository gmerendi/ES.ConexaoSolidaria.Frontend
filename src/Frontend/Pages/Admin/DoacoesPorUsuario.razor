@page "/doacoes/usuario"
@attribute [Authorize(Roles = "GESTOR_ONG")]
@inject DoacaoService DoacaoSvc

<PageTitle>Doações por Usuário — Conexão Solidária</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Doações por Usuário</MudText>
<MudText Typo="Typo.body2" Class="mb-5" Style="color:#666;">
    Pesquise pelo e-mail do usuário para visualizar todas as doações realizadas por ele.
</MudText>

<MudGrid Spacing="4">

    <!-- ═══════ Coluna esquerda — busca ═══════ -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="2" Style="border-radius:16px;">

            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:700; color:#1B5E20;">
                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Class="mr-1" Style="vertical-align:middle;" />
                Buscar por E-mail
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-3">
                <MudTextField @bind-Value="_email"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Style="flex:1;"
                              Disabled="@_buscando"
                              @onkeyup="BuscarSeEnter" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Style="border-radius:24px; height:56px; min-width:80px; font-weight:600;"
                           OnClick="BuscarAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_email) || _buscando)">
                    @if (_buscando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <span>Buscar</span>
                    }
                </MudButton>
            </MudStack>

            @if (_erros.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @foreach (var e in _erros)
                    {
                        <div>@e</div>
                    }
                </MudAlert>
            }

        </MudPaper>
    </MudItem>

    <!-- ═══════ Coluna direita — doações ═══════ -->
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-6" Elevation="2" Style="border-radius:16px; min-height:300px;">

            @if (!_buscaRealizada)
            {
                <div style="text-align:center; padding:3rem 0; color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Style="font-size:3rem;" />
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Informe um e-mail para ver as doações.
                    </MudText>
                </div>
            }
            else
            {
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1rem;">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight:700; color:#1B5E20;">
                            @_emailBuscado
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#888;">
                            @_doacoes.Count doação(ões) •
                            Total aprovado: R$ @_totalAprovado.ToString("N2", _culturaBR)
                        </MudText>
                    </div>
                    @if (_buscando)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                    }
                </div>

                @if (!_doacoes.Any() && !_buscando)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Nenhuma doação encontrada para este e-mail.
                    </MudAlert>
                }
                else
                {
                    <div style="max-height:460px; overflow-y:auto; border-radius:8px; border:1px solid #E0E0E0;">
                        @foreach (var d in _doacoes)
                        {
                            <div @onclick="@(() => AbrirDetalhe(d))"
                                 class="doacao-row"
                                 style="padding:12px 16px; cursor:pointer; border-bottom:1px solid #F0F0F0;
                                display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@d.TituloCampanha</MudText>
                                    <MudText Typo="Typo.caption" Style="color:#888;">@d.DataDoacao</MudText>
                                </div>
                                <div style="display:flex; align-items:center; gap:12px;">
                                    <MudChip T="string"
                                             Color="@ObterCorStatus(d.StatusDoacao)"
                                             Variant="Variant.Filled"
                                             Size="Size.Small"
                                             Style="font-weight:600;">
                                        @d.StatusDoacao
                                    </MudChip>
                                    <MudText Typo="Typo.body1" Style="font-weight:700; color:#2E7D32;">
                                        R$ @d.ValorDoacao.ToString("N2", _culturaBR)
                                    </MudText>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </MudPaper>
    </MudItem>

</MudGrid>

<!-- ═══════ Modal — Detalhes da Doação ═══════ -->
<MudDialog @bind-Visible="_modalAberto"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="mr-2"
                     Style="vertical-align:middle; color:#2E7D32;" />
            Detalhes da Doação
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_doacaoDetalhada is not null)
        {
            var d = _doacaoDetalhada;
            <MudStack Spacing="3">
                <MudDivider />
                <MudText Typo="Typo.overline" Style="color:#888; font-weight:600;">Campanha</MudText>
                <DadosUsuarioRow Label="Título" Valor="@d.TituloCampanha" />
                <DadosUsuarioRow Label="GUID" Valor="@d.GuidCampanha.ToString()" />

                <MudDivider />
                <MudText Typo="Typo.overline" Style="color:#888; font-weight:600;">Doação</MudText>
                <DadosUsuarioRow Label="Valor" Valor="@($"R$ {d.ValorDoacao.ToString("N2", _culturaBR)}")" CorValor="#2E7D32" />

                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <MudText Typo="Typo.body2" Style="color:#666;">Status</MudText>
                    <MudChip T="string"
                             Color="@ObterCorStatus(d.StatusDoacao)"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Style="font-weight:600;">
                        @d.StatusDoacao
                    </MudChip>
                </div>

                <DadosUsuarioRow Label="Data" Valor="@d.DataDoacao" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Style="border-radius:24px;"
                   OnClick="@(() => _modalAberto = false)">
            Fechar
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .doacao-row:hover {
        background: #F5F5F5;
    }
</style>

@code {
    private string _email = string.Empty;
    private string _emailBuscado = string.Empty;
    private bool _buscando;
    private bool _buscaRealizada;
    private List<DoacaoCampanhaDto> _doacoes = new();
    private List<string> _erros = new();
    private bool _modalAberto;
    private DoacaoCampanhaDto? _doacaoDetalhada;

    // Cálculo acumulado apenas das doações APROVADAS
    private decimal _totalAprovado => _doacoes
        .Where(d => d.StatusDoacao.ToString().ToUpper().Contains("APROVADA") || d.StatusDoacao.ToString() == "1")
        .Sum(d => d.ValorDoacao);

    private static readonly System.Globalization.CultureInfo _culturaBR = new("pt-BR");

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;

        _buscando = true;
        _buscaRealizada = false;
        _doacoes = new();
        _erros = new();
        _emailBuscado = _email.Trim();

        var (sucesso, doacoes, erros) = await DoacaoSvc.ObterPorUsuarioAsync(_emailBuscado);

        _buscaRealizada = true;
        if (sucesso) _doacoes = doacoes;
        else _erros = erros;

        _buscando = false;
    }

    private async Task BuscarSeEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarAsync();
    }

    private void AbrirDetalhe(DoacaoCampanhaDto doacao)
    {
        _doacaoDetalhada = doacao;
        _modalAberto = true;
    }

    // Mapeamento dinâmico de cores do status
    private Color ObterCorStatus(object status)
    {
        var statusStr = status?.ToString()?.ToUpper() ?? "";

        if (statusStr.Contains("APROVADA") || statusStr == "1")
            return Color.Success; // Verde

        if (statusStr.Contains("RECUSADA") || statusStr.Contains("REPROVADA") || statusStr == "2")
            return Color.Error; // Vermelho

        return Color.Default; // Cinza/Padrão (Processando)
    }
}