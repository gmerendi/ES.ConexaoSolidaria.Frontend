@page "/doacoes/usuario"
@attribute [Authorize(Roles = "GESTOR_ONG")]
@inject UsuarioService UsuarioSvc
@inject DoacaoService DoacaoSvc

<PageTitle>Doações por Usuário — Conexão Solidária</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Doações por Usuário</MudText>
<MudText Typo="Typo.body2" Class="mb-5" Style="color:#666;">
    Pesquise um usuário pelo e-mail e visualize todas as doações realizadas por ele.
</MudText>

<MudGrid Spacing="4">

    <!-- ═══════ Coluna esquerda — busca de usuário ═══════ -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-6" Elevation="2" Style="border-radius:16px;">

            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:700; color:#1B5E20;">
                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Class="mr-1" Style="vertical-align:middle;" />
                Buscar Usuário
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-3">
                <MudTextField @bind-Value="_email"
                              Label="E-mail"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Style="flex:1;"
                              Disabled="@_buscando"
                              @onkeyup="BuscarSeEnter" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Style="border-radius:24px; height:56px; min-width:80px; font-weight:600;"
                           OnClick="BuscarAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_email) || _buscando)">
                    @if (_buscando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {

                        <span>Buscar</span>
                    }
                </MudButton>
            </MudStack>

            @if (_errosBusca.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    @foreach (var e in _errosBusca)
                    {
                        <div>@e</div>
                    }
                </MudAlert>
            }

            @if (_usuario is not null)
            {
                <MudDivider Class="mb-3" />
                <MudStack Spacing="2">
                    <DadosUsuarioRow Label="Nome" Valor="@_usuario.NomeCompleto" />
                    <DadosUsuarioRow Label="E-mail" Valor="@_usuario.Email" />
                    <DadosUsuarioRow Label="CPF" Valor="@_usuario.Cpf" />
                    <DadosUsuarioRow Label="Perfil" Valor="@_usuario.Perfil" />
                    <DadosUsuarioRow Label="Status" Valor="@_usuario.Status"
                                     CorValor="@(_usuario.Status == "ACTIVE" ? "#2E7D32" : "#C62828")" />
                </MudStack>
            }

        </MudPaper>
    </MudItem>

    <!-- ═══════ Coluna direita — doações do usuário ═══════ -->
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-6" Elevation="2" Style="border-radius:16px; min-height:300px;">

            @if (_usuario is null)
            {
                <div style="text-align:center; padding:3rem 0; color:#bbb;">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Style="font-size:3rem;" />
                    <MudText Typo="Typo.body2" Class="mt-2">
                        Pesquise um usuário para ver as doações.
                    </MudText>
                </div>
            }
            else
            {
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:1rem;">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight:700; color:#1B5E20;">
                            @_usuario.NomeCompleto
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#888;">
                            @_doacoes.Count doação(ões) •
                            Total: R$ @_doacoes.Sum(d => d.ValorDoacao).ToString("N2")
                        </MudText>
                    </div>
                    @if (_carregandoDoacoes)
                    {
                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                    }
                </div>

                @if (_errosDoacoes.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                        @foreach (var e in _errosDoacoes)
                        {
                            <div>@e</div>
                        }
                    </MudAlert>
                }
                else if (!_doacoes.Any() && !_carregandoDoacoes)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Este usuário ainda não realizou nenhuma doação.
                    </MudAlert>
                }
                else
                {
                    <div style="max-height:460px; overflow-y:auto; border-radius:8px; border:1px solid #E0E0E0;">
                        @foreach (var d in _doacoes)
                        {
                            <div @onclick="@(() => AbrirDetalhe(d))"
                                 class="doacao-row"
                                 style="padding:12px 16px; cursor:pointer; border-bottom:1px solid #F0F0F0;
                                display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@d.TituloCampanha</MudText>
                                    <MudText Typo="Typo.caption" Style="color:#888;">@d.DataDoacao</MudText>
                                </div>
                                <MudText Typo="Typo.body1" Style="font-weight:700; color:#2E7D32;">
                                    R$ @d.ValorDoacao.ToString("N2")
                                </MudText>
                            </div>
                        }
                    </div>
                }
            }

        </MudPaper>
    </MudItem>

</MudGrid>

<!-- ═══════ Modal — Detalhes da Doação ═══════ -->
<MudDialog @bind-Visible="_modalAberto"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="mr-2"
                     Style="vertical-align:middle; color:#2E7D32;" />
            Detalhes da Doação
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_doacaoDetalhada is not null)
        {
            var d = _doacaoDetalhada;
            <MudStack Spacing="3">
                <MudDivider />

                <MudText Typo="Typo.overline" Style="color:#888; font-weight:600;">Campanha</MudText>
                <DadosUsuarioRow Label="Título" Valor="@d.TituloCampanha" />
                <DadosUsuarioRow Label="GUID" Valor="@d.GuidCampanha.ToString()" />

                <MudDivider />

                <MudText Typo="Typo.overline" Style="color:#888; font-weight:600;">Doação</MudText>
                <DadosUsuarioRow Label="Valor" Valor="@($"R$ {d.ValorDoacao.ToString("N2")}")"
                                 CorValor="#2E7D32" />
                <DadosUsuarioRow Label="Data" Valor="@d.DataDoacao" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Style="border-radius:24px;"
                   OnClick="@(() => _modalAberto = false)">
            Fechar
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .doacao-row:hover {
        background: #F5F5F5;
    }
</style>

@code {
    // ═══ Busca de usuário ═══
    private string _email = string.Empty;
    private bool _buscando;
    private UsuarioDto? _usuario;
    private List<string> _errosBusca = new();

    // ═══ Doações ═══
    private List<DoacaoCampanhaDto> _doacoes = new();
    private bool _carregandoDoacoes;
    private List<string> _errosDoacoes = new();

    // ═══ Modal ═══
    private bool _modalAberto;
    private DoacaoCampanhaDto? _doacaoDetalhada;

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;

        _buscando = true;
        _usuario = null;
        _doacoes = new();
        _errosBusca = new();
        _errosDoacoes = new();

        var (sucesso, usuario, erros) = await UsuarioSvc.ObterPorEmailAsync(_email.Trim());

        if (sucesso && usuario is not null)
        {
            _usuario = usuario;
            await CarregarDoacoesAsync(usuario.Guid);
        }
        else
        {
            _errosBusca = erros;
        }

        _buscando = false;
    }

    private async Task CarregarDoacoesAsync(Guid guidUsuario)
    {
        _carregandoDoacoes = true;
        _errosDoacoes = new();

        var (sucesso, doacoes, erros) = await DoacaoSvc.ObterPorUsuarioAsync(guidUsuario);

        if (sucesso) _doacoes = doacoes;
        else _errosDoacoes = erros;

        _carregandoDoacoes = false;
    }

    private async Task BuscarSeEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarAsync();
    }

    private void AbrirDetalhe(DoacaoCampanhaDto doacao)
    {
        _doacaoDetalhada = doacao;
        _modalAberto = true;
    }
}
