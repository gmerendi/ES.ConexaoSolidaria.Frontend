@inherits LayoutComponentBase

<MudThemeProvider Theme="@_tema" />
<MudDialogProvider />
<MudSnackbarProvider />

@Body

@code {
    private readonly MudTheme _tema = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary        = "#2E7D32",
            PrimaryDarken  = "#1B5E20",
            PrimaryLighten = "#81C784",
            Secondary      = "#FF6F00",
            Background     = "#FAFAFA",
            Surface        = "#FFFFFF",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = new[] { "Inter", "Roboto", "sans-serif" } },
            H1 = new H1Typography { FontSize = "2.8rem", FontWeight = "700", LineHeight = "1.2" },
            H2 = new H2Typography { FontSize = "2rem",   FontWeight = "700" },
            H4 = new H4Typography { FontSize = "1.4rem", FontWeight = "600" },
        }
    };
}
